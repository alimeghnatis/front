{
  "name": "@aztlan/morphosa",
  "version": "3.8.3",
  "description": "",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "style": "src/index.scss",
  "scripts": {
    "test": "jest",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint --ext .tsx,.ts ./ --quiet",
    "format:eslint": "npm run test:eslint -- --fix",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "build-with-babel --format cjs",
    "build:esm": "build-with-babel --format esm",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@aztlan/eslint-config-base": "^3.6.3",
    "@aztlan/postcss-config": "^0.9.0",
    "@aztlan/stylelint-config": "^0.9.0",
    "@aztlan/typescript-config": "^3.6.3",
    "@types/jest": "^29.5.12",
    "cssnano": "^6.1.2",
    "jest": "^29.7.0",
    "postcss-cli": "^11.0.0",
    "postcss-preset-env": "^9.5.9",
    "sass": "^1.75.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "eslintConfig": {
    "extends": "@aztlan/eslint-config-base"
  },
  "buildConfig": {
    "entryPoints": [
      "./src/**/*.{ts,tsx,js,jsx}"
    ],
    "up": 1
  }
}
